# Supabase configuration for the Web app.
# Copy this file to `.env.local` and fill in your project values.
# Only variables prefixed with VITE_ are exposed to the browser (Vite convention).

# Project URL, e.g. https://abcdefghijklmno.supabase.co
VITE_SUPABASE_URL=

# Public anon key (safe to ship to the browser). NEVER put the service_role key here.
VITE_SUPABASE_ANON_KEY=

# --- Firebase (alternative backend — see Firebase_Architecture.md) ---
# All VITE_FIREBASE_* values are public by design; security lives in Firestore Rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
